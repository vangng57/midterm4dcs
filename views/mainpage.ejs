    <script>
        function automode() {
            // Thực hiện các thao tác khi chế độ tự động được chọn
            logMessage("Auto mode selected.");
            writeplcdata(["Auto","Manual"],[true,false]);
        }

        
        function showTrend() {
            const content1 = document.getElementById("content-1");
            content1.innerHTML = `
                <div class="trend-charts">
                    <canvas id="trendChart1" width="400" height="200"></canvas>
                    <canvas id="trendChart2" width="400" height="200"></canvas>
                </div>
            `;

            // Biểu đồ 1: Hiệu suất
            const ctx1 = document.getElementById('trendChart1').getContext('2d');
            new Chart(ctx1, {
                type: 'line',
                data: {
                    labels: ['10:00', '10:05', '10:10', '10:15', '10:20', '10:25'],
                    datasets: [{
                        label: 'Cement',
                        data: [100, 105, 98, 110, 115, 120],
                        borderColor: 'rgba(75, 192, 192, 1)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        tension: 0.4
                    },
                    {
                        label: 'Sand',
                        data: [90, 95, 88, 100, 105, 110],
                        borderColor: 'rgba(255, 99, 132, 1)',
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        tension: 0.4
                    },
                    {
                        label: 'Fly ash',
                        data: [80, 85, 78, 90, 95, 100],
                        borderColor: 'rgba(54, 162, 235, 1)',
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        tension: 0.4
                    },
                    {
                        label: 'Mineral',
                        data: [70, 75, 68, 80, 85, 90],
                        borderColor: 'rgba(255, 206, 86, 1)',
                        backgroundColor: 'rgba(255, 206, 86, 0.2)',
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true, position: 'top' }
                    },
                    scales: {
                        x: { beginAtZero: true },
                        y: { beginAtZero: true }
                    }
                }
            });

            // Biểu đồ 2: Lượng nguyên liệu
            const ctx2 = document.getElementById('trendChart2').getContext('2d');
            new Chart(ctx2, {
                type: 'line',
                data: {
                    labels: ['10:00', '10:05', '10:10', '10:15', '10:20', '10:25'],
                    datasets: [{
                        label: 'Additive 1 (kg)',
                        data: [500, 520, 510, 530, 540, 550],
                        borderColor: 'rgba(255, 99, 132, 1)',
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        tension: 0.4
                    },
                    {
                        label: 'Additive 2 (kg)',
                        data: [300, 310, 320, 300, 290, 280],
                        borderColor: 'rgba(54, 162, 235, 1)',
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        tension: 0.4
                    },
                    {
                        label: 'Additive 3 (kg)',
                        data: [400, 380, 350, 410, 420, 390],
                        borderColor: 'rgba(255, 206, 86, 1)',
                        backgroundColor: 'rgba(255, 206, 86, 0.2)',
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        zoom: {
                            pan: {
                                enabled: true,
                                mode: 'x', // Chỉ kéo theo trục x
                            },
                            zoom: {
                                wheel: {
                                    enabled: true, // Thu phóng bằng con lăn chuột
                                },
                                pinch: {
                                    enabled: true // Thu phóng bằng cảm ứng
                                },
                                mode: 'x', // Chỉ thu phóng theo trục x
                            },
                        }
                    },
                    scales: {
                        x: { beginAtZero: true },
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        function showManual() {
            logMessage("Manual mode selected.");
            writeplcdata(["Manual","Auto"],[true,false]);

            const content1 = document.getElementById("content-1");

            // Danh sách các nút và tag PLC tương ứng
            const buttonTasks = [
                { name: "Cement Screw", tag: "Cement_Screw", id: "valve_8_status" },
                { name: "Fly Ash Screw", tag: "Flyash_Screw", id: "valve_13_status" },
                { name: "Sand Screw", tag: "Sand_Screw", id: "valve_9_status" },
                { name: "Mineral Screw", tag: "Mineral_Screw", id: "valve_12_status" },
                { name: "Mixer", tag: "Mixer", id: "valve_10_status" },
                { name: "Conveyor Chute", tag: "Conveyor_Chute", id: "valve_11_status" },
                { name: "Hopper Valve PG 1", tag: "Hopper_PG1", id: "valve_6_status" },
                { name: "Hopper Valve PG 2", tag: "Hopper_PG2", id: "valve_5_status" },
                { name: "Hopper Valve PG 3", tag: "Hopper_PG3", id: "valve_4_status" },
                { name: "PG Scale Valve", tag: "PG_Scale_Valve", id: "valve_3_status" },
                { name: "Sand Scale Valve", tag: "Sand_Scale_Valve", id: "valve_1_status" },
                { name: "Mineral Ash Valve", tag: "Mineral_Ash_Valve", id: "valve_2_status" },
                { name: "Mixer Valve Open", tag: "Mixer_Valve_Open", id: "valve_7_status" }
                //{ name: "Mixer Valve Close", tag: "Mixer_Valve_Close" },
                //{ name: "Sand Valve Vibrator", tag: "Sand_Valve_Vibrator" },
                //{ name: "PG Ash Valve Vibrator", tag: "PG_Ash_Valve_Vibrator" }
            ];

            // Tạo HTML cho các nút
            content1.innerHTML = `
                <div class="manual-grid">
                    ${buttonTasks.map(task => `
                        <button 
                            class="manual-btn on" 
                            data-tag="${task.tag}" 
                            onclick="handleManualButtonClick('${task.tag}', this, '${task.id}')">
                            ${task.name}
                        </button>
                    `).join("")}
                </div>
            `;
        }
        function handleManualButtonClick(tag, button, id) {
            // Kiểm tra trạng thái hiện tại của nút
            const isOn = button.classList.contains('on'); // Kiểm tra xem nút có lớp 'on' hay không 
            const color = document.getElementById(id);
            if (!color) {
                console.error(`Element with ID "${id}" not found.`);
                return;
            }
            
            // Cập nhật giao diện nút
            if (isOn) {
                writeplcdata(tag, true);
                // Cập nhật trạng thái của nút
                color.style.backgroundColor = '#4dbf5f';
                button.classList.remove('on');
                button.classList.add('off');
                logMessage(`${tag} turned ON.`);
            } else {
                writeplcdata(tag, false);
                color.style.backgroundColor = "red";
                button.classList.remove('off');
                button.classList.add('on');
                logMessage(`${tag} turned OFF.`);
            }
        }

        function showRecipeList() {
            const content1 = document.getElementById("content-1");

            // Gửi yêu cầu lấy danh sách công thức
            fetch('/readrecipelist', { method: 'POST' })
                .then(response => response.json())
                .then(recipes => {
                    // Hiển thị danh sách công thức
                    content1.innerHTML = `
                        <div class="recipe-list">
                            ${recipes
                                .map(
                                    recipe => `
                                        <button class="recipe-btn" onclick="editRecipe(${recipe.id})">${recipe.name}</button>
                                    `
                                )
                                .join("")}
                            ${recipes.length < 12
                                ? `<button class="recipe-btn add-recipe-btn" onclick="addNewRecipe()">+</button>`
                                : ""}
                        </div>
                    `;
                })
                .catch(err => {
                    console.error('Lỗi khi lấy danh sách công thức:', err);
                    content1.innerHTML = `<p class="error">Không thể lấy danh sách công thức!</p>`;
                });
        }



        function editRecipe(recipeId) {
            fetch(`/readrecipelist`, { method: 'POST' })
                .then(response => response.json())
                .then(recipes => {
                    const recipe = recipes.find(r => r.id === recipeId);

                    if (!recipe) {
                        alert('Không tìm thấy công thức!');
                        return;
                    }

                    const content1 = document.getElementById("content-1");
                    content1.innerHTML = `
                        <div class="recipe-form">
                            <h3>Chỉnh sửa công thức</h3>
                            <div class="input-group">
                                <label for="recipe-name">Tên công thức:</label>
                                <input type="text" id="recipe-name" value="${recipe.name}" required>
                            </div>
                            <div class="input-group">
                                <label for="batch_number">Num of batch:</label>
                                <input type="number" id="batch_number" value="${recipe.batch_number}" min="0" required>
                            </div>
                            <div class="input-group">
                                <label for="total_weight">Total weight:</label>
                                <input type="number" id="total_weight" value="${recipe.total_weight}" min="0" required>
                            </div>
                            <div class="input-group">
                                <label for="cement">Xi măng (%):</label>
                                <input type="number" id="cement" value="${recipe.cement}" min="0" max="100" required>
                            </div>
                            <div class="input-group">
                                <label for="sand">Cát (%):</label>
                                <input type="number" id="sand" value="${recipe.sand}" min="0" max="100" required>
                            </div>
                            <div class="input-group">
                                <label for="mineral">Khoáng (%):</label>
                                <input type="number" id="mineral" value="${recipe.mineral}" min="0" max="100" required>
                            </div>
                            <div class="input-group">
                                <label for="flyash">Tro bay (%):</label>
                                <input type="number" id="flyash" value="${recipe.flyash}" min="0" max="100" required>
                            </div>
                            <div class="input-group">
                                <label for="additive1">Phụ gia 1 (kg):</label>
                                <input type="number" id="additive1" value="${recipe.additive1}" min="0" required>
                            </div>
                            <div class="input-group">
                                <label for="additive2">Phụ gia 2 (kg):</label>
                                <input type="number" id="additive2" value="${recipe.additive2}" min="0" required>
                            </div>
                            <div class="input-group">
                                <label for="additive3">Phụ gia 3 (kg):</label>
                                <input type="number" id="additive3" value="${recipe.additive3}" min="0" required>
                            </div>
                            <div class"manual-grid">
                                <button type="button" onclick="applyRecipe()">Apply</button>
                                <button type="button" onclick="deleteRecipeConfirmation('${recipe.name}')">Delete</button>
                                <button type="button" onclick="showRecipeList()">Back</button>
                            </div>
                        </div>
                    `;
                })
                .catch(err => console.error('Lỗi khi lấy thông tin công thức:', err));
        }

        function addNewRecipe() {
            const content1 = document.getElementById("content-1");
            content1.innerHTML = `
                <div class="recipe-form">
                    <h3>Thêm công thức mới</h3>
                    <div class="input-group">
                        <label for="recipe-name">Tên công thức:</label>
                        <input type="text" id="recipe-name" placeholder="Nhập tên công thức" required>
                    </div>
                    <div class="input-group">
                        <label for="batch_number">Num of batch:</label>
                        <input type="number" id="batch_number" placeholder="Enter num of batch" min="0" required>
                    </div>
                    <div class="input-group">
                        <label for="total_weight">Total weight:</label>
                        <input type="number" id="total_weight" placeholder="Enter the total weight (kg)" min="0" required>
                    </div>
                    <div class="input-group">
                        <label for="cement">Xi măng (%):</label>
                        <input type="number" id="cement" placeholder="Nhập % xi măng" min="0" max="100" required>
                    </div>
                    <div class="input-group">
                        <label for="sand">Cát (%):</label>
                        <input type="number" id="sand" placeholder="Nhập % cát" min="0" max="100" required>
                    </div>
                    <div class="input-group">
                        <label for="mineral">Khoáng (%):</label>
                        <input type="number" id="mineral" placeholder="Nhập % khoáng" min="0" max="100" required>
                    </div>
                    <div class="input-group">
                        <label for="flyash">Tro bay (%):</label>
                        <input type="number" id="flyash" placeholder="Nhập % tro bay" min="0" max="100" required>
                    </div>
                    <div class="input-group">
                        <label for="additive1">Phụ gia 1 (kg):</label>
                        <input type="number" id="additive1" placeholder="Nhập phụ gia 1" min="0" required>
                    </div>
                    <div class="input-group">
                        <label for="additive2">Phụ gia 2 (kg):</label>
                        <input type="number" id="additive2" placeholder="Nhập phụ gia 2" min="0" required>
                    </div>
                    <div class="input-group">
                        <label for="additive3">Phụ gia 3 (kg):</label>
                        <input type="number" id="additive3" placeholder="Nhập phụ gia 3" min="0" required>
                    </div>
                    <button type="button" onclick="saveNewRecipe()">Lưu công thức</button>
                </div>
            `;
        }

        function saveNewRecipe() {
            const name = document.getElementById('recipe-name').value;
            const cement = document.getElementById('cement').value;
            const sand = document.getElementById('sand').value;
            const mineral = document.getElementById('mineral').value;
            const flyash = document.getElementById('flyash').value;
            const additive1 = document.getElementById('additive1').value;
            const additive2 = document.getElementById('additive2').value;
            const additive3 = document.getElementById('additive3').value;
            const batch_number = document.getElementById('batch_number').value;
            const total_weight = document.getElementById('total_weight').value;

            const recipe = { name, cement, sand, mineral, flyash, additive1, additive2, additive3 , total_weight, batch_number};
            logMessage("New recipe saved successfully.");
            console.log("Dữ liệu gửi lên server:", recipe);
            fetch('/addrecipe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(recipe),
            })
                .then(response => response.json())
                .then(data => {
                    alert(data.message);
                    showRecipeList(); // Hiển thị lại danh sách công thức
                })
                .catch(err => console.error('Lỗi khi thêm công thức:', err));
        }

        let recipeNameToDelete = "";

        function deleteRecipeConfirmation(recipeName) {
            recipeNameToDelete = recipeName; // Lưu tên công thức
            const popup = document.getElementById('delete-confirmation');
            popup.style.display = 'flex'; // Hiển thị popup
        }

        document.getElementById('confirm-delete').addEventListener('click', () => {
            // Xóa công thức sau khi xác nhận
            deleteRecipe(recipeNameToDelete);
            document.getElementById('delete-confirmation').style.display = 'none'; // Đóng popup
        });

        document.getElementById('cancel-delete').addEventListener('click', () => {
            // Hủy xóa và đóng popup
            document.getElementById('delete-confirmation').style.display = 'none';
        });

        function deleteRecipe(recipe_name) {

            // Kiểm tra nếu tên công thức không hợp lệ
            if (!recipe_name) {
                alert('Tên công thức không hợp lệ! Vui lòng kiểm tra lại.');
                return;
            }

            fetch('/deleteRecipe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: recipe_name }), // Gửi trường "name" đúng với API
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Lỗi trong quá trình xóa công thức.');
                    }
                    return response.json();
                })
                .then(data => {
                    alert(data.message); // Hiển thị thông báo thành công
                    showRecipeList(); // Hiển thị lại danh sách công thức
                })
                .catch(err => console.error('Lỗi khi xóa công thức:', err));
        }

        function applyRecipe() {
            // Lấy giá trị từ các trường nhập liệu
            const total_weight = document.getElementById('total_weight').value || "0.000";
            const cement = document.getElementById('cement').value * total_weight /100 || "0.000";
            const sand = document.getElementById('sand').value * total_weight /100 || "0.000";
            const mineral = document.getElementById('mineral').value* total_weight /100 || "0.000";
            const flyash = document.getElementById('flyash').value* total_weight /100 || "0.000";
            const additive1 = document.getElementById('additive1').value || "0.000";
            const additive2 = document.getElementById('additive2').value || "0.000";
            const additive3 = document.getElementById('additive3').value || "0.000";

            // Cập nhật bảng "Công thức hiện tại"
            document.getElementById('current-cement').textContent = parseFloat(cement).toFixed(3);
            document.getElementById('current-sand').textContent = parseFloat(sand).toFixed(3);
            document.getElementById('current-mineral').textContent = parseFloat(mineral).toFixed(3);
            document.getElementById('current-flyash').textContent = parseFloat(flyash).toFixed(3);
            document.getElementById('current-additive1').textContent = parseFloat(additive1).toFixed(3);
            document.getElementById('current-additive2').textContent = parseFloat(additive2).toFixed(3);
            document.getElementById('current-additive3').textContent = parseFloat(additive3).toFixed(3);

            const startButton = document.getElementById('start-button');
            startButton.disabled = false;
            const resetButton = document.getElementById('reset-button');
            resetButton.disabled = false;
            // Thông báo cập nhật thành công
            logMessage("Recipe values applied successfully!");
        }
        // Hàm xử lý sự kiện khi người dùng nhấn nút "Lưu"

        function writeplcdata(tag, value) {
            fetch('/writeplcdata', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tag: tag, value: value }) // Sử dụng tag PLC
            })
            .then(response => response.json())
            .then(data => {
                //alert(data.message); // Hiển thị thông báo phản hồi
                console.log(data.message);
            })
            .catch(err => {
                console.error('Error while writting data:', err);
            });
        }
        
        const MAX_HISTORY_POINTS = 5 * 3600;
        let fullLabels = []; // Lưu toàn bộ nhãn thời gian
        let fullCementData = []; // Lưu toàn bộ dữ liệu xi măng
        let fullSandData = []; // Lưu toàn bộ dữ liệu cát
        let fullMineralData = []; // Lưu toàn bộ dữ liệu khoáng
        let fullFlyashData = []; // Lưu toàn bộ dữ liệu tro bay
        let fullAdditive1Data = []; // Lưu toàn bộ dữ liệu phụ gia 1
        let fullAdditive2Data = []; // Lưu toàn bộ dữ liệu phụ gia 2
        let fullAdditive3Data = []; // Lưu toàn bộ dữ liệu phụ gia 3
        // Hàm cập nhật biểu đồ
        function updateCharts() {
            // Biểu đồ 1: Xi măng, Cát, Khoáng, Tro bay
            if (!window.materialChart) {
                const ctx1 = document.getElementById('trendChart1').getContext('2d');
                window.materialChart = new Chart(ctx1, {
                    type: 'line',
                    data: {
                        labels: fullLabels, // Thời gian
                        datasets: [
                            {
                                label: 'Cement (kg)',
                                data: fullCementData,
                                borderColor: 'rgba(255, 99, 132, 1)',
                                backgroundColor: 'rgba(255, 99, 132, 0.2)',
                                tension: 0.4,
                            },
                            {
                                label: 'Sand (kg)',
                                data: fullSandData,
                                borderColor: 'rgba(54, 162, 235, 1)',
                                backgroundColor: 'rgba(54, 162, 235, 0.2)',
                                tension: 0.4,
                            },
                            {
                                label: 'Mineral (kg)',
                                data: fullMineralData,
                                borderColor: 'rgba(75, 192, 192, 1)',
                                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                                tension: 0.4,
                            },
                            {
                                label: 'Flyash (kg)',
                                data: fullFlyashData,
                                borderColor: 'rgba(255, 206, 86, 1)',
                                backgroundColor: 'rgba(255, 206, 86, 0.2)',
                                tension: 0.4,
                            },
                        ],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            zoom: {
                                pan: { enabled: true, mode: 'x' },
                                zoom: {
                                    wheel: { enabled: true },
                                    pinch: { enabled: true },
                                    mode: 'x',
                                },
                            },
                        },
                        scales: {
                            x: {
                                title: { display: true, text: 'Time' },
                            },
                            y: {
                                title: { display: true, text: 'Material (kg)' },
                            },
                        },
                    },
                });
            } else {
                // Cập nhật dữ liệu nếu biểu đồ đã được khởi tạo
                window.materialChart.data.labels = fullLabels;
                window.materialChart.data.datasets[0].data = fullCementData;
                window.materialChart.data.datasets[1].data = fullSandData;
                window.materialChart.data.datasets[2].data = fullMineralData;
                window.materialChart.data.datasets[3].data = fullFlyashData;
                window.materialChart.update();
            }

            // Biểu đồ 2: 3 Phụ gia
            if (!window.additiveChart) {
                const ctx2 = document.getElementById('trendChart2').getContext('2d');
                window.additiveChart = new Chart(ctx2, {
                    type: 'line',
                    data: {
                        labels: fullLabels, // Thời gian
                        datasets: [
                            {
                                label: 'Additive 1 (kg)',
                                data: fullAdditive1Data,
                                borderColor: 'rgba(153, 102, 255, 1)',
                                backgroundColor: 'rgba(153, 102, 255, 0.2)',
                                tension: 0.4,
                            },
                            {
                                label: 'Additive 2 (kg)',
                                data: fullAdditive2Data,
                                borderColor: 'rgba(255, 159, 64, 1)',
                                backgroundColor: 'rgba(255, 159, 64, 0.2)',
                                tension: 0.4,
                            },
                            {
                                label: 'Additive 3 (kg)',
                                data: fullAdditive3Data,
                                borderColor: 'rgba(54, 162, 235, 1)',
                                backgroundColor: 'rgba(54, 162, 235, 0.2)',
                                tension: 0.4,
                            },
                        ],
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            zoom: {
                                pan: { enabled: true, mode: 'x' },
                                zoom: {
                                    wheel: { enabled: true },
                                    pinch: { enabled: true },
                                    mode: 'x',
                                },
                            },
                        },
                        scales: {
                            x: {
                                title: { display: true, text: 'Time' },
                            },
                            y: {
                                title: { display: true, text: 'Additives (kg)' },
                            },
                        },
                    },
                });
            } else {
                // Cập nhật dữ liệu nếu biểu đồ đã được khởi tạo
                window.additiveChart.data.labels = fullLabels;
                window.additiveChart.data.datasets[0].data = fullAdditive1Data;
                window.additiveChart.data.datasets[1].data = fullAdditive2Data;
                window.additiveChart.data.datasets[2].data = fullAdditive3Data;
                window.additiveChart.update();
            }
        }
        function updateActualValues() {
            fetch('/readplcdata', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
                // Cập nhật giá trị thực tế vào bảng
                const cementValue = data.values?.Cement_Value || 0;
                document.getElementById('actual-cement').textContent = parseFloat(cementValue).toFixed(3);
                fullCementData.push(cementValue);
                const sandValue = data.values?.Sand_Value || 0;
                document.getElementById('actual-sand').textContent = parseFloat(sandValue).toFixed(3);
                fullSandData.push(sandValue);
                const mineralValue = data.values?.Mineral_Value || 0;
                document.getElementById('actual-mineral').textContent = parseFloat(mineralValue).toFixed(3);
                fullMineralData.push(mineralValue);
                const flyashValue = data.values?.Flyash_Value || 0;
                document.getElementById('actual-flyash').textContent = parseFloat(flyashValue).toFixed(3);
                fullFlyashData.push(flyashValue);
                const additive1Value = data.values?.Additive1_Value || 0;    
                document.getElementById('actual-additive1').textContent = parseFloat(additive1Value).toFixed(3);
                fullAdditive1Data.push(additive1Value);
                const additive2Value = data.values?.Additive2_Value || 0;
                document.getElementById('actual-additive2').textContent = parseFloat(additive2Value).toFixed(3);
                fullAdditive2Data.push(additive2Value);
                const additive3Value = data.values?.Additive3_Value || 0;
                document.getElementById('actual-additive3').textContent = parseFloat(additive3Value).toFixed(3);
                fullAdditive3Data.push(additive3Value);
                fullLabels.push(getCurrentTime());

                // const circle_status = [
                //         valve_1_status = data.values["Sand_Scale_Valve"], valve_2_status = data.values["Mineral_Ash_Valve"], valve_3_status = data.values["PG_Scale_Valve"],
                //         valve_4_status = data.values["Hopper_PG3"], valve_5_status = data.values["Hopper_PG2"], valve_6_status = data.values["Hopper_PG1"],
                //         valve_7_status = data.values["Mixer_Valve_Open"], valve_8_status = data.values["Cement_Screw"], valve_9_status = data.values["Sand_Screw"],
                //         valve_10_status = data.values["Mixer"], valve_11_status = data.values["Conveyor_Chute"], valve_12_status = data.values["Mineral_Screw"],
                //         valve_13_status = data.values["Flyash_Screw"]
                //     ]
                // Kiểm tra và loại bỏ các điểm dữ liệu cũ nếu cần
                if (fullLabels.length > MAX_HISTORY_POINTS) {
                    fullLabels.shift();
                    fullCementData.shift();
                    fullSandData.shift();
                    fullFlyashData.shift();
                }
                // Cập nhật biểu đồ
                //updateCharts();
            })
            .catch(err => console.error('Lỗi khi gọi API đọc PLC:', err));
        }

        // Gọi hàm mỗi giây để cập nhật bảng
        setInterval(updateActualValues, 5000);

        function start() {
            try {
                // Lấy giá trị từ bảng "Công thức hiện tại"
                const total_weight = parseFloat(document.getElementById('total_weight').value) || 0;
                const batch_ref = parseFloat(document.getElementById('batch_number').value) || 0;
                const cement_ref = parseFloat(document.getElementById('cement').value) || 0;
                const sand_ref = parseFloat(document.getElementById('sand').value) || 0;
                const mineral_ref = parseFloat(document.getElementById('mineral').value) || 0;
                const flyash_ref = parseFloat(document.getElementById('flyash').value) || 0;
                const additive1_ref = parseFloat(document.getElementById('additive1').value) || 0;
                const additive2_ref = parseFloat(document.getElementById('additive2').value) || 0;
                const additive3_ref = parseFloat(document.getElementById('additive3').value) || 0;

                // Tạo danh sách các tag và giá trị cần ghi xuống PLC
                const tags = [
                    'Total_Weight', 'Batch_ref', 'Cement_ref', 'Sand_ref',
                    'Mineral_ref', 'Flyash_ref', 'PG01_ref', 'PG02_ref', 
                    'PG03_ref', 'Start', 'estop'
                ];

                const values = [
                    total_weight, batch_ref, cement_ref, sand_ref,
                    mineral_ref, flyash_ref, additive1_ref, additive2_ref,
                    additive3_ref, true, false
                ];

                // Gửi toàn bộ dữ liệu xuống PLC thông qua API
                fetch('/writeplcdata', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tag: tags, value: values }) // Sử dụng tag và value
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`API trả về lỗi: ${response.statusText}`);
                    }
                    return response.json();
                })
                .then(data => {
                    logMessage("System started successfully."); // Log thông báo thành công

                    // Thay đổi trạng thái của nút "Start" và "eStop"
                    const stopButton = document.getElementById('stop-button');
                    stopButton.disabled = false;
                    //stopButton.style.zIndex = 1;
                    const startButton = document.getElementById('start-button');
                    startButton.disabled = true;
                    //startButton.style.zIndex = 0;
                })
                .catch(err => {
                    console.error('Error while writing data:', err);
                    logMessage('Error starting the system. Please check the configuration!', 1); // Log lỗi
                });
            } catch (err) {
                console.error('Unexpected error in start function:', err);
                logMessage('Unexpected error occurred while starting the system.', 1); // Log lỗi không mong muốn
            }
        }

        function estop() {
            // Thực hiện các thao tác dừng hệ thống ở đây
            writeplcdata(['estop','Start'], [true,false]);
            const stopButton = document.getElementById('stop-button');
            stoptButton.disabled = true;
            const startButton = document.getElementById('start-button');
            startButton.disabled = false;
            logMessage("System stopped.");
        }

        function reset() {
            // Thực hiện các thao tác reset hệ thống ở đây
            logMessage("System reset.");
            writeplcdata(["Reset","estop","Start","Auto","Manual"],[true,false,false,false,false]);
            const stopButton = document.getElementById('stop-button');
            stopButton.disabled = true;
            const startButton = document.getElementById('start-button');
            startButton.disabled = true;
            const resetButton = document.getElementById('reset-button');
            resetButton.disabled = true;
        }

        function getCurrentTime() {
            const now = new Date();
            const date = now.toLocaleDateString(); // Lấy ngày (định dạng: dd/mm/yyyy hoặc mm/dd/yyyy)
            const time = now.toLocaleTimeString(); // Lấy giờ (định dạng: hh:mm:ss)
            return `${date} ${time}`; // Kết hợp ngày và giờ
        }

        function logMessage(message, isError = 0) {
            const logContainer = document.getElementById("log-container");

            // Lấy thời gian hiện tại
            const timestamp = getCurrentTime();

            // Tạo nội dung log mới
            const logEntry = document.createElement("div");
            logEntry.textContent = `[${timestamp}] ${message}`;

            if (isError === 1) {
                logEntry.style.color = "red"; // Màu đỏ cho lỗi
            } else {
                logEntry.style.color = "black"; // Màu đen mặc định
            }
            logContainer.appendChild(logEntry);

            // Tự động cuộn xuống cuối khung log
            logContainer.scrollTop = logContainer.scrollHeight;

            fetch('/addLog', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    timestamp: timestamp, // Gửi timestamp đầy đủ
                    message_text: message 
                })
            })
            .then(response => response.json())
            .then(data => {
                console.log('Log saved successfully:', data.message);
            })
            .catch(err => {
                console.error('Error saving log to database:', err);
            });
        }
    </script>
</body>
</html>